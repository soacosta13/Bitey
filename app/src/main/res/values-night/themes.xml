<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Bitey" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Lime reads well on dark backgrounds; forest green does not (1.8:1) -->
        <item name="colorPrimary">@color/bitey_secondary</item>
        <!-- Dark text on top of the lime -->
        <item name="colorOnPrimary">@color/bitey_background</item>
        <item name="colorSecondary">@color/bitey_secondary</item>
        <item name="colorOnSecondary">@color/bitey_background</item>

        <item name="android:windowBackground">@color/bitey_background</item>
        <item name="colorOnBackground">@color/bitey_text_primary</item>
        <item name="colorSurface">@color/bitey_surface</item>
        <item name="colorOnSurface">@color/bitey_text_primary</item>
        <item name="colorSurfaceVariant">@color/bitey_secondary_background</item>
        <item name="colorOnSurfaceVariant">@color/bitey_text_secondary</item>
        <item name="colorOutline">@color/bitey_border</item>
    </style>

    <style name="Theme.Bitey" parent="Base.Theme.Bitey" />
</resources>

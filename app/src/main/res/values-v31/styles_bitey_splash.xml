        <item name="android:windowSplashScreenBackground">@color/bitey_background</item>

        <!-- Hide the system splash icon -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/bitey_splash_clear_icon</item>

    </style>

</resources>

